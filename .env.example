# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Development
NODE_ENV="development"


# Use this to force nixpacks to use node 20 instead of 18, which is its default version. This is needed when deploying on coolify.
NIXPACKS_NODE_VERSION=20

OPENAI_API_KEY=your-api-key

ENCRYPTION_KEY=your-encryption-key

# Stripe
STRIPE_SECRET_KEY=sk_test_your_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Stripe Price IDs (create these in Stripe Dashboard)
NEXT_PUBLIC_STRIPE_PRICE_FREELANCER_MONTHLY=price_freelancer_monthly_id
NEXT_PUBLIC_STRIPE_PRICE_FREELANCER_ANNUAL=price_freelancer_annual_id
NEXT_PUBLIC_STRIPE_PRICE_AGENCY_MONTHLY=price_agency_monthly_id
NEXT_PUBLIC_STRIPE_PRICE_AGENCY_ANNUAL=price_agency_annual_id
NEXT_PUBLIC_STRIPE_PRICE_SCALE_MONTHLY=price_scale_monthly_id
NEXT_PUBLIC_STRIPE_PRICE_SCALE_ANNUAL=price_scale_annual_id

# Optional: Stripe Test Clock ID for simulating subscription lifecycle (leave empty for real-time)
STRIPE_TEST_CLOCK_ID=
