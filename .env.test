# Template for E2E test environment.
# This file IS committed (see .gitignore: !.env.test) — keep it as a template only.
# Copy to .env.test.local and fill in real values for the dedicated test Supabase project.
# .env.test.local is gitignored via the .env* rule.

# Supabase (use a SEPARATE project from dev — tests truncate/seed data on each run)
NEXT_PUBLIC_SUPABASE_URL=https://your-test-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-test-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-test-service-role-key

# App URL (Playwright spawns `npm run dev` on this URL)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Encryption key for encrypted n8n credentials at rest.
# At least 32 characters of high-entropy random data. Generate with:
#   openssl rand -base64 32
ENCRYPTION_KEY=your-test-encryption-key

# OpenAI — only required if E2E tests exercise document embedding
OPENAI_API_KEY=your-api-key
